SUPABASE_URL=
SUPABASE_ANON_KEY=

# Aladin TTB API key (도서 메타/가격/중고 정보 조회)
ALADIN_TTB_KEY=

# ------------------------------------------------------------------
# 플랫폼 로그 수집 (선택) — /api/logs/sync 가 쓴다.
# 비워 두면 그 소스는 「미설정」으로 보고되고 수집을 건너뛴다.
# (설정 안 된 것과 로그가 0건인 것은 다른 상태라 화면에서 구분해 보여준다.)
# ------------------------------------------------------------------

# Vercel 개인 액세스 토큰 + 대상 프로젝트
#   토큰: Vercel → Account Settings → Tokens
#   프로젝트 ID: Project Settings → General → Project ID (prj_ 로 시작)
#   팀 소유 프로젝트면 VERCEL_TEAM_ID 도 필요
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Supabase Management API 토큰 + 프로젝트 ref
#   토큰: https://supabase.com/dashboard/account/tokens (sbp_ 로 시작)
#   ref : 프로젝트 URL 의 서브도메인
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_PROJECT_REF=
