SUPABASE_URL=
SUPABASE_ANON_KEY=

# Aladin TTB API key (도서 메타/가격/중고 정보 조회)
ALADIN_TTB_KEY=

# ------------------------------------------------------------------
# 플랫폼 로그 수집 (선택) — /api/logs/sync 가 쓴다.
# 비워 두면 그 소스는 「미설정」으로 보고되고 수집을 건너뛴다.
# (설정 안 된 것과 로그가 0건인 것은 다른 상태라 화면에서 구분해 보여준다.)
# ------------------------------------------------------------------

# Vercel 개인 액세스 토큰 + 대상 프로젝트
#   토큰: Vercel → Account Settings → Tokens
#   프로젝트 ID: Project Settings → General → Project ID (prj_ 로 시작)
#   팀 소유 프로젝트면 VERCEL_TEAM_ID 도 필요
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Supabase Management API 토큰 + 프로젝트 ref
#   토큰: https://supabase.com/dashboard/account/tokens (sbp_ 로 시작)
#   ref : 프로젝트 URL 의 서브도메인
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_PROJECT_REF=

# ------------------------------------------------------------------
# 플랫폼 로그 일일 초기화 (크론)
# ------------------------------------------------------------------
# 크론이 /api/logs/cleanup 을 부를 때 쓰는 비밀값.
# Vercel 이 Authorization: Bearer <이 값> 을 붙여 보낸다.
# 비어 있으면 그 경로는 아무것도 지우지 않고 401 을 준다(주소만 알면 누구나
# 로그를 비울 수 있게 두지 않기 위해서다).
CRON_SECRET=

# 관리자 키 — 크론처럼 로그인한 사용자가 없는 작업에서만 쓴다.
# 이미 Vercel 에 등록돼 있다. RLS 를 통과하므로 사용자 요청 경로에서는 쓰지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# 소셜 로그인
# ------------------------------------------------------------------
# 구글 로그인의 콜백 주소를 고정하고 싶을 때만 넣는다.
# 비우면 요청 헤더에서 알아서 잡는다(로컬·프리뷰·운영 모두 동작).
APP_BASE_URL=
