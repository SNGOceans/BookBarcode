{
  "name": "book-barcode-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Book Reader 데스크톱 셸 — 배포된 사이트를 여는 창",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sngoceans.bookbarcode",
    "productName": "Book Reader",
    "copyright": "SNGOceans",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "offline.html"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "BookReaderSetup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Book Reader"
    }
  }
}
